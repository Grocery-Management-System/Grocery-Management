<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650" prefWidth="1000" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="grocery.system.controller.LowStockReportController">

    <top>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16">
                    <HBox alignment="CENTER_LEFT" fillHeight="false" maxWidth="Infinity">
                        <Button onAction="#onGoToHomePage" prefHeight="18" prefWidth="70"
                                style="-fx-background-color: #FFFFFF; -fx-font-size: 12; -fx-background-radius: 6; -fx-border-color: black; -fx-border-radius: 6; -fx-text-fill: #333;"
                                text="Home">
                            <HBox.margin>
                                <Insets left="5.0" top="5.0" />
                            </HBox.margin>
                        </Button>
                    </HBox>
                    <Label alignment="CENTER" prefHeight="50.0" prefWidth="993.0" text="Low Stock Report" textAlignment="CENTER">
                        <font>
                            <Font size="28.0" />
                        </font>
                    </Label>
                    <HBox alignment="CENTER" />
                </VBox>
            </content>
        </ScrollPane>
    </top>
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Items Below Threshold">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>

            <TableView fx:id="lowStockTable" prefHeight="450">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="80" text="ID" />
                    <TableColumn fx:id="nameColumn" prefWidth="250" text="Product Name" />
                    <TableColumn fx:id="stockColumn" prefWidth="150" text="Current Stock" />
                    <TableColumn fx:id="thresholdColumn" prefWidth="150" text="Threshold" />
                    <TableColumn fx:id="aisleColumn" prefWidth="100" text="Aisle" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER" spacing="15">
            </HBox>
        </VBox>
    </center>

</BorderPane>