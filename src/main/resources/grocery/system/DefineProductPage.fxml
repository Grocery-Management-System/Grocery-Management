<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="grocery.system.controller.DefineProductPageController"
            prefHeight="520.0" prefWidth="460.0"
            style="-fx-background-color: #f8f9fa;">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          spacing="0">

        <!-- ── Header bar ── -->
        <HBox style="-fx-background-color: #999DA0; -fx-padding: 20 24 20 24;"
              alignment="CENTER_LEFT" spacing="12">
            <Label text="Add New Product"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>

        </HBox>

        <!-- ── Form body ── -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;
                                             -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="16" style="-fx-padding: 24 24 8 24; -fx-background-color: #f8f9fa;">

                <!-- Product Name -->
                <VBox spacing="6">
                    <Label text="Product Name *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #495057;"/>
                    <TextField fx:id="productNameField"
                               promptText="e.g. Whole Milk"
                               style="-fx-background-color: white; -fx-border-color: #ced4da;
                                      -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-padding: 8 12 8 12; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Category -->
                <VBox spacing="6">
                    <Label text="Category *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #495057;"/>
                    <ComboBox fx:id="categoryComboBox"
                              promptText="Select a category"
                              maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-border-color: #ced4da;
                                     -fx-border-radius: 6; -fx-background-radius: 6;
                                     -fx-font-size: 13px;"/>
                </VBox>

                <!-- Supplier -->
                <VBox spacing="6">
                    <Label text="Supplier *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #495057;"/>
                    <ComboBox fx:id="supplierComboBox"
                              promptText="Select a supplier"
                              maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-border-color: #ced4da;
                                     -fx-border-radius: 6; -fx-background-radius: 6;
                                     -fx-font-size: 13px;"/>
                </VBox>

                <!-- Stock + Threshold row -->
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Current Stock *"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;
                                      -fx-text-fill: #495057;"/>
                        <TextField fx:id="currentStockField"
                                   promptText="0"
                                   style="-fx-background-color: white; -fx-border-color: #ced4da;
                                          -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-padding: 8 12 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Min Threshold *"
                               style="-fx-font-size: 12px; -fx-font-weight: bold;
                                      -fx-text-fill: #495057;"/>
                        <TextField fx:id="minThresholdField"
                                   promptText="0"
                                   style="-fx-background-color: white; -fx-border-color: #ced4da;
                                          -fx-border-radius: 6; -fx-background-radius: 6;
                                          -fx-padding: 8 12 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Aisle Number -->
                <VBox spacing="6">
                    <Label text="Aisle Number *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #495057;"/>
                    <TextField fx:id="aisleNumberField"
                               promptText="e.g. 5"
                               style="-fx-background-color: white; -fx-border-color: #ced4da;
                                      -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-padding: 8 12 8 12; -fx-font-size: 13px"/>
                </VBox>

                <!-- Unit Price -->
                <VBox spacing="6">
                    <Label text="Unit Price* ($)"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                            -fx-text-fill:#495057"/>
                    <TextField fx:id="unitPriceField"
                               promptText="e.g. 5.00"
                               style="-fx-background-color: white; -fx-border-color: #ced4da;
                                    -fx-border-radius: 6; -fx-background-radius: 6;
                                    -fx-padding: 8 12 8 12; -fx-font-size: 13px"/>
                </VBox>


                <!-- Perishable checkbox -->
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-padding: 12 16 12 16;
                             -fx-border-color: #ced4da; -fx-border-radius: 6;
                             -fx-background-radius: 6;">
                    <CheckBox fx:id="perishableCheckBox"/>
                    <VBox spacing="2">
                        <Label text="Perishable Product"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #343a40;"/>
                        <Label text="This product has an expiration date"
                               style="-fx-font-size: 11px; -fx-text-fill: #868e96;"/>
                    </VBox>
                </HBox>


                <!-- Error label (hidden until needed) -->
                <Label fx:id="errorLabel" text=""
                       style="-fx-text-fill: #dc3545; -fx-font-size: 12px;"
                       visible="false" managed="false"/>

            </VBox>
        </ScrollPane>

        <HBox style="-fx-background-color: white; -fx-padding: 16 24 16 24;
                     -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;"
              spacing="12" alignment="CENTER_RIGHT">
            <Button text="Cancel"
                    onAction="#onCancel"
                    style="-fx-background-color: white; -fx-border-color: #ced4da;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 8 20 8 20; -fx-font-size: 13px;
                           -fx-cursor: hand; -fx-text-fill: #495057;"/>
            <Button text="Add Product"
                    onAction="#onSaveProduct"
                    style="-fx-background-color: white; -fx-border-color: #ced4da;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-padding: 8 20 8 20; -fx-font-size: 13px;
                           -fx-cursor: hand; -fx-text-fill: #495057;"/>
        </HBox>

    </VBox>
</AnchorPane>
