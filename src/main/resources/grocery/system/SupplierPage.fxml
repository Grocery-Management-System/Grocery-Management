<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650" prefWidth="1000" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="grocery.system.controller.SupplierPageController">
    <top>
        <VBox spacing="16">
            <!-- Navigation Header matching Create Order -->
            <HBox alignment="CENTER_LEFT" fillHeight="false" maxWidth="Infinity">
                <Button onAction="#onGoToHomePage" prefHeight="18" prefWidth="70"
                        style="-fx-background-color: #FFFFFF; -fx-font-size: 12; -fx-background-radius: 6; -fx-border-color: black; -fx-border-radius: 6; -fx-text-fill: #333;"
                        text="Home">
                    <HBox.margin>
                        <Insets left="5.0" top="5.0" />
                    </HBox.margin>
                </Button>
            </HBox>

            <!-- Centered Title -->
            <Label alignment="CENTER" prefWidth="1000.0" text="Supplier Directory">
                <font>
                    <Font size="28.0" />
                </font>
            </Label>

            <!-- Organized Toolbar: Search and Action Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>
                <TextField fx:id="searchField" prefWidth="300.0" promptText="Search by ID or Name..." />

                <Region HBox.hgrow="ALWAYS" /> <!-- Pushes buttons to the right -->

                <Button onAction="#onAddSupplier" prefWidth="140.0" text="Add New Supplier"
                        style="-fx-background-color: white; -fx-border-color: #bbb; -fx-border-radius: 3;" />
                <Button onAction="#onDeleteSupplier" prefWidth="100.0" text="Delete"
                        style="-fx-background-color: #f8f8f8; -fx-border-color: #d9534f; -fx-text-fill: #d9534f; -fx-border-radius: 3;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <TableView fx:id="supplierTable" VBox.vgrow="ALWAYS">
                <columns>
                    <!-- Column names match Supplier.java fields -->
                    <TableColumn fx:id="idColumn" maxWidth="100.0" minWidth="60.0" prefWidth="80.0" text="ID" />
                    <TableColumn fx:id="nameColumn" minWidth="200.0" prefWidth="250.0" text="Supplier Name" />
                    <TableColumn fx:id="addressColumn" minWidth="300.0" prefWidth="400.0" text="Address" />
                    <TableColumn fx:id="phoneColumn" minWidth="150.0" prefWidth="200.0" text="Phone Number" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>